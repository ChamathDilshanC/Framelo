# ---------------------------------------------------------------------------
# Framelo environment
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the two values below.
#
# Framelo runs without any of this. With no Supabase project configured the
# editor is fully usable in guest mode: projects go to IndexedDB, media to
# IndexedDB, and patterns, device finishes and export all work. Adding these
# turns on accounts, cloud sync, share links and portfolios.
#
# Where to find them:
#   Supabase dashboard -> Project settings -> API Keys
#
# Both values are browser-safe. What actually protects the data is the row
# level security in `supabase/migrations/` — the key only says "I am an
# anonymous visitor", and the policies decide what that visitor may read.
#
# NEVER put the service_role key (or an `sb_secret_...` key) in this file, in
# `.env.local`, or anywhere a `NEXT_PUBLIC_` variable can reach: those bypass
# row level security entirely and every `NEXT_PUBLIC_` value is compiled into
# the JavaScript sent to the browser.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase has two key formats and Framelo accepts either:
#
#   sb_publishable_...   the current format — use this for a new project
#   eyJhbGci...          the legacy `anon` JWT — still fully supported
#
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# Absolute origin used to build share links and Open Graph URLs.
# Leave unset locally; it falls back to the request's own origin.
# NEXT_PUBLIC_SITE_URL=https://framelo.app

# ---------------------------------------------------------------------------
# After filling these in, apply the database schema — the app will report
# "table not found" until you do. Either:
#
#   npx supabase link --project-ref <your-ref>
#   npx supabase db push
#
# or paste `supabase/schema.sql` into the dashboard's SQL editor and run it.
# ---------------------------------------------------------------------------
